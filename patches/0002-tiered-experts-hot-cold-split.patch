+ggml_tensor * llama_model_qwen4exp::graph::build_moe_split(ggml_tensor * cur, int il) {
+    const auto & layer = model.layers[il];
+    const int64_t n_embd   = cur->ne[0];
+    const int64_t n_tokens = cur->ne[1];
+
+    // routing: identical to build_moe_ffn (softmax, top-k, renormalize, scale), but the router rows
+    // were permuted at load time, so the ids are slots: [0, n_hot) hot, [n_hot, n_expert) cold
+    ggml_tensor * logits = build_lora_mm(layer.ffn_gate_inp, cur); // [n_expert, n_tokens]
+    cb(logits, "ffn_moe_logits", il);
+    ggml_tensor * probs = ggml_soft_max(ctx0, logits);
+    cb(probs, "ffn_moe_probs", il);
+    ggml_tensor * selected = ggml_argsort_top_k(ctx0, probs, n_expert_used); // [n_expert_used, n_tokens]
+    cb(selected, "ffn_moe_topk", il);
+
+    ggml_tensor * weights = ggml_get_rows(ctx0, ggml_reshape_3d(ctx0, probs, 1, n_expert, n_tokens), selected); // [1, n_used, n_tokens]
+    weights = ggml_reshape_2d(ctx0, weights, n_expert_used, n_tokens);
+    ggml_tensor * weights_sum = ggml_clamp(ctx0, ggml_sum_rows(ctx0, weights), 6.103515625e-5, INFINITY);
+    weights = ggml_div(ctx0, weights, weights_sum);
+    if (hparams.expert_weights_scale != 0.0f && hparams.expert_weights_scale != 1.0f) {
+        weights = ggml_scale(ctx0, weights, hparams.expert_weights_scale);
+    }
+    ggml_build_forward_expand(gf, weights);
+
+    // every tier reads the router's slot ids directly: mul_mat_id with an id range (ggml_mul_mat_id_set_range)
+    // skips slots outside the tier and writes zero rows, so the tiers' outputs simply add up
+    ggml_tensor * x = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
+    ggml_tensor * experts = nullptr;
+    for (int t = 0; t < layer.n_expert_tiers; ++t) {
+        if (layer.expert_tier_n[t] == 0 || layer.ffn_down_exps_t[t] == nullptr) {
+            continue;
+        }
+        const int32_t lo = layer.expert_tier_off[t];
+        ggml_tensor * up   = build_lora_mm_id(layer.ffn_up_exps_t[t],   x, selected); // [n_ff, n_used, n_tokens]
+        ggml_mul_mat_id_set_range(up, lo);
+        ggml_tensor * gate = build_lora_mm_id(layer.ffn_gate_exps_t[t], x, selected);
+        ggml_mul_mat_id_set_range(gate, lo);
+        ggml_tensor * act  = ggml_swiglu_split(ctx0, gate, up);
+        ggml_tensor * out  = build_lora_mm_id(layer.ffn_down_exps_t[t], act, selected); // [n_embd, n_used, n_tokens]
+        ggml_mul_mat_id_set_range(out, lo);
+        cb(out, "ffn_moe_tier_out", il);
+        experts = experts ? ggml_add(ctx0, experts, out) : out;
+    }
+    experts = ggml_mul(ctx0, experts, ggml_reshape_3d(ctx0, weights, 1, n_expert_used, n_tokens));
+
+    // sum over the selected experts
