+// Hot/cold expert split. LLAMA_EXPERT_SPLIT names a text file with one line per split layer:
+//   <layer> <n_hot> <e_0> <e_1> ... <e_{n_expert-1}>
+// a permutation of the layer's experts, hottest first. The first n_hot experts are loaded into
+// ffn_{gate,up,down}_exps, the rest into ffn_{gate,up,down}_exps.cold, and the router rows are
+// permuted the same way so the router emits slot ids directly. Place the cold tensors with
+// -ot "exps\.cold=CPU". Routing statistics come from an imatrix (see tools/expert-split).
+static std::map<int, std::pair<int, std::vector<int32_t>>> qwen4exp_read_expert_split(int64_t n_expert) {
+    std::map<int, std::pair<int, std::vector<int32_t>>> res;
+    const char * path = getenv("LLAMA_EXPERT_SPLIT");
+    if (path == nullptr || path[0] == '\0') {
+        return res;
+    }
+    std::ifstream f(path);
+    if (!f) {
+        throw std::runtime_error(format("LLAMA_EXPERT_SPLIT: cannot open %s", path));
+    }
+    std::string line;
+    while (std::getline(f, line)) {
+        if (line.empty() || line[0] == '#') {
+            continue;
+        }
+        std::istringstream ss(line);
+        int il = -1, n_hot = -1;
+        ss >> il >> n_hot;
+        std::vector<int32_t> perm;
+        int32_t e;
+        while (ss >> e) {
+            perm.push_back(e);
+        }
+        std::vector<char> seen(n_expert, 0);
+        for (int32_t x : perm) {
+            if (x < 0 || x >= n_expert || seen[x]) {
+                throw std::runtime_error(format("LLAMA_EXPERT_SPLIT: layer %d is not a permutation of %" PRId64 " experts", il, n_expert));
+            }
+            seen[x] = 1;
+        }
+        if ((int64_t) perm.size() != n_expert || n_hot < 1 || n_hot >= n_expert) {
+            throw std::runtime_error(format("LLAMA_EXPERT_SPLIT: bad line for layer %d", il));
+        }
+        res[il] = { n_hot, perm };
+    }
+    LLAMA_LOG_INFO("%s: hot/cold expert split from %s for %zu layers\n", __func__, path, res.size());
+    return res;
+}
